<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BottomNavigationItemText">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ReviewChoiceChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textColor">@color/filter_chip_text</item>
        <item name="chipBackgroundColor">@color/filter_chip_background</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="closeIconVisible">false</item>
    </style>

    <style name="Widget.StudyPin.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:textColor">@color/surface_color</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/brand_main</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="Widget.StudyPin.Button.Secondary" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:textColor">@color/brand_main</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/button_secondary</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="Widget.StudyPin.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">52dp</item>
        <item name="android:textColor">@color/brand_main</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/surface_color</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">@color/brand_main</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.StudyPin.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_height">52dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@color/brand_main</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
