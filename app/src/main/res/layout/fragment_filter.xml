<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="36dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFilterTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Filters"
                    android:textColor="@color/brand_main"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnCloseFilters"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="0dp"
                    android:layout_marginVertical="0dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close filters"
                    android:src="@drawable/ic_close" />

            </LinearLayout>

            <!-- Amenities Filters -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Amenities"
                android:textColor="@color/brand_main"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilterAmenities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="0dp"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterWifi"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wi-Fi"
                    android:textColor="@color/filter_chip_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/filter_chip_background"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterOutlets"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Outlets"
                    android:textColor="@color/filter_chip_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/filter_chip_background"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterPrinting"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Printing"
                    android:textColor="@color/filter_chip_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/filter_chip_background"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterQuiet"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quiet"
                    android:textColor="@color/filter_chip_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/filter_chip_background"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterWashroom"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Washroom"
                    android:textColor="@color/filter_chip_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/filter_chip_background"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterFood"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Food"
                    android:textColor="@color/filter_chip_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/filter_chip_background"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterParking"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Parking"
                    android:textColor="@color/filter_chip_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/filter_chip_background"
                    app:chipStrokeWidth="0dp" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Environment Filters -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Environment"
                android:textColor="@color/brand_main"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilterEnvironment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="4dp"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterIndoor"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Indoor"
                    android:textColor="@color/filter_chip_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/filter_chip_background"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterOutdoor"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Outdoor"
                    android:textColor="@color/filter_chip_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/filter_chip_background"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterGroupFriendly"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Group Friendly"
                    android:textColor="@color/filter_chip_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/filter_chip_background"
                    app:chipStrokeWidth="0dp" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Availability Filters -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Availability"
                android:textColor="@color/brand_main"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterAvailableOnly"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Only Display Open Spots"
                android:textColor="@color/filter_chip_text"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/filter_chip_background"
                app:chipStrokeWidth="0dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Sort by"
                android:textColor="@color/brand_main"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Drop-down menu -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutFilterSort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxStrokeColor="@color/dropdown_border"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:endIconMode="dropdown_menu"
                app:endIconTint="@color/brand_main">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/dropdownFilterSort"
                    style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:popupBackground="@drawable/bg_dropdown_popup"
                    android:dropDownVerticalOffset="8dp"
                    android:gravity="center_vertical|start"
                    android:includeFontPadding="false"
                    android:inputType="none"
                    android:minHeight="52dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="48dp"
                    android:singleLine="true"
                    android:textSize="16sp"
                    android:textColor="@color/brand_main"
                    app:simpleItemSelectedColor="@color/dropdown_selected_background"
                    app:simpleItemSelectedRippleColor="@color/dropdown_selected_background"
                    app:simpleItemLayout="@layout/item_dropdown_option" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="52dp"
        android:text="Apply Filters"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:backgroundTint="@color/brand_main"
        app:cornerRadius="10dp" />

</LinearLayout>
