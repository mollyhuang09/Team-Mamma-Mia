<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutSpotInactiveInfo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/layoutSpotInactiveReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_subtle_box"
        android:gravity="top"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="2dp"
            android:contentDescription="@string/preview_inactive_reason_info"
            android:src="@drawable/ic_info" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSpotInactiveReasonTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preview_inactive_reason_title"
                android:textColor="@color/brand_main"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSpotInactiveReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/preview_inactive_reason"
                android:textColor="@color/brand_main"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSpotInactiveLearnMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/preview_learn_more"
                android:textColor="@color/brand_main"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/viewSpotLastVerifiedDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/border_default" />

    <LinearLayout
        android:id="@+id/layoutSpotLastVerified"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Last verified"
            android:src="@drawable/ic_history" />

        <TextView
            android:id="@+id/tvSpotLastVerifiedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/preview_last_verified"
            android:textColor="@color/brand_main"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSpotLastVerifiedDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/surface_muted"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
