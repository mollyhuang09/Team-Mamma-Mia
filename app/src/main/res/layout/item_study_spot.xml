<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginBottom="12dp"
    app:contentPadding="12dp"
    app:cardBackgroundColor="@color/surface_color"
    app:cardCornerRadius="8dp"
    app:strokeColor="@color/border_default"
    app:strokeWidth="1dp" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Image -->
        <ImageView
            android:id="@+id/ivSpotImage"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:scaleType="centerCrop"
            android:src="@drawable/photo_placeholder"
            android:contentDescription="Study spot image" />

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <!-- Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSpotName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Spot name"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tvOccupancyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available"
                    android:textSize="12sp"/>

            </LinearLayout>

            <!-- Detailed Info -->
            <!-- Rating & Gem Info -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp" >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#x2605;"
                    android:textSize="14sp"
                    android:textColor="@color/star_default"
                    android:layout_marginEnd="2dp" />

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.5 (42)"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/tvHiddenGemBlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone" >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" • "
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvHiddenGemBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💎 2 hidden gems"
                        android:textSize="12sp"
                        android:textColor="@color/diamond_default" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" • "
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvVerifiedBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✅ Verified"
                        android:textSize="12sp"
                        android:textColor="@color/verified_green" />

                </LinearLayout>

            </LinearLayout>

            <!-- Tags -->
            <include layout="@layout/view_spot_tag_group" />

            <!-- Address -->
            <TextView
                android:id="@+id/tvSpotAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spot Address"
                android:textSize="12sp"
                android:textColor="@color/surface_muted"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>