<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <include
        layout="@layout/view_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        layout="@layout/view_spot_tag_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutListSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="8dp"
        android:paddingHorizontal="0dp"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSpotCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 Spots Found"
            android:textColor="@color/brand_main"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSortSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sort: Rating"
            android:textColor="@color/brand_main"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Sort order"
            android:src="@drawable/ic_move_down" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSpots"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>
