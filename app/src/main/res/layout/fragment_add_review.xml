<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    tools:context=".ui.review.AddReviewFragment"
    tools:theme="@style/Theme.StudyPin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            android:layout_marginStart="-16dp" />

        <TextView
            android:id="@+id/tvReviewTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/add_review_title"
            android:textColor="@color/brand_main"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSpotName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="@color/surface_muted"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/layoutOverallStars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Rate specific features (optional)"
            android:textColor="@color/brand_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutAmenityRatings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/review_details_hint"
            app:boxStrokeColor="@color/brand_main"
            app:hintTextColor="@color/surface_muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReviewText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:minLines="4"
                android:textColor="@color/brand_main" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddMedia"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Add photos or videos"
            android:textColor="@color/brand_main"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_camera"
            app:iconTint="@color/brand_main"
            app:strokeColor="@color/brand_main"
            app:strokeWidth="1dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="When did you go? (optional)"
            android:textColor="@color/brand_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupVisitTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/chipMorning"
                style="@style/ReviewChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Morning"
                app:checkedIconVisible="false" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipAfternoon"
                style="@style/ReviewChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Afternoon"
                app:checkedIconVisible="false" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipEvening"
                style="@style/ReviewChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Evening"
                app:checkedIconVisible="false" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipNight"
                style="@style/ReviewChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Night"
                app:checkedIconVisible="false" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="How busy was it? (optional)"
            android:textColor="@color/brand_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCrowd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/chipQuiet"
                style="@style/ReviewChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quiet"
                app:checkedIconVisible="false" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipModerate"
                style="@style/ReviewChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Moderate"
                app:checkedIconVisible="false" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipBusy"
                style="@style/ReviewChoiceChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Busy"
                app:checkedIconVisible="false" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="What best describes this spot? (optional)"
            android:textColor="@color/brand_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupDescriptors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="0dp"
            app:singleSelection="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipReviewPrinting"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Printing"
                android:textColor="@color/filter_chip_text"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/filter_chip_background"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipReviewFood"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food"
                android:textColor="@color/filter_chip_text"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/filter_chip_background"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipReviewParking"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parking"
                android:textColor="@color/filter_chip_text"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/filter_chip_background"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipReviewIndoor"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Indoor"
                android:textColor="@color/filter_chip_text"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/filter_chip_background"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipReviewOutdoor"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Outdoor"
                android:textColor="@color/filter_chip_text"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/filter_chip_background"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipReviewGroupFriendly"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Group Friendly"
                android:textColor="@color/filter_chip_text"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/filter_chip_background"
                app:chipStrokeWidth="0dp" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitReview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:enabled="false"
            android:minHeight="56dp"
            android:text="Submit Review"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:backgroundTint="@color/review_submit_background"
            app:cornerRadius="14dp" />

    </LinearLayout>
</ScrollView>
