<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mapFragment">

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.studypin.app.ui.map.MapFragment"
        android:label="Map">
        <action
            android:id="@+id/action_map_to_spotDetail"
            app:destination="@id/spotDetailFragment"/>
    </fragment>

    <fragment
        android:id="@+id/listFragment"
        android:name="com.studypin.app.ui.list.ListFragment"
        android:label="List">
        <action
            android:id="@+id/action_list_to_spotDetail"
            app:destination="@id/spotDetailFragment"/>
        <action
            android:id="@+id/action_list_to_spotGroup"
            app:destination="@id/spotGroupFragment"/>
        <action
            android:id="@+id/action_list_to_filter"
            app:destination="@id/filterFragment"/>
        <action
            android:id="@+id/action_list_to_search"
            app:destination="@id/searchFragment"/>
    </fragment>

    <fragment
        android:id="@+id/filterFragment"
        android:name="com.studypin.app.ui.filter.FilterFragment"
        android:label="Filters" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.studypin.app.ui.search.SearchFragment"
        android:label="Search" />

    <fragment
        android:id="@+id/spotGroupFragment"
        android:name="com.studypin.app.ui.group.SpotGroupFragment"
        android:label="Spot group">
        <argument
            android:name="parentSpotId"
            app:argType="string"/>
        <action
            android:id="@+id/action_spotGroup_to_spotDetail"
            app:destination="@id/spotDetailFragment"/>
    </fragment>

    <fragment
        android:id="@+id/addSpotFragment"
        android:name="com.studypin.app.ui.add.AddSpotFragment"
        android:label="Add Spot"/>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.studypin.app.ui.profile.ProfileFragment"
        android:label="Profile"/>

    <fragment
        android:id="@+id/spotDetailFragment"
        android:name="com.studypin.app.ui.detail.SpotDetailFragment"
        android:label="Spot Detail">
        <argument
            android:name="spotId"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_spotDetail_to_editSpot"
            app:destination="@id/editSpotFragment"/>
        <action
            android:id="@+id/action_spotDetail_to_reportFlag"
            app:destination="@id/reportFlagFragment"/>
        <action
            android:id="@+id/action_spotDetail_to_reviewList"
            app:destination="@id/reviewListFragment" />
        <action
            android:id="@+id/action_spotDetail_to_addReview"
            app:destination="@id/addReviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/reviewListFragment"
        android:name="com.studypin.app.ui.review.ReviewListFragment"
        android:label="Reviews">
        <argument
            android:name="spotId"
            app:argType="string" />
        <action
            android:id="@+id/action_reviewList_to_addReview"
            app:destination="@id/addReviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/addReviewFragment"
        android:name="com.studypin.app.ui.review.AddReviewFragment"
        android:label="Add Review">
        <argument
            android:name="spotId"
            app:argType="string" />
        <argument
            android:name="initialRating"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>

    <fragment
        android:id="@+id/editSpotFragment"
        android:name="com.studypin.app.ui.edit.EditSpotFragment"
        android:label="Edit Spot"/>

    <fragment
        android:id="@+id/reportFlagFragment"
        android:name="com.studypin.app.ui.report.ReportFlagFragment"
        android:label="Report a Problem"/>

</navigation>
